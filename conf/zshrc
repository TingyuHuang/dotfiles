# Path to the oh-my-zsh installation.
export ZSH="${HOME}/.oh-my-zsh"

# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
# bullet-train is installed by install.sh into $ZSH/custom/themes.
ZSH_THEME="bullet-train"

# Which plugins to load. Standard ones live in $ZSH/plugins, custom ones in
# $ZSH_CUSTOM/plugins. Add wisely, they slow down shell startup.
#
#   zsh-autosuggestions      grey hint from history while typing; the right
#                            arrow or End accepts it, and it is only a
#                            suggestion until you do
#   zsh-syntax-highlighting  colours the command line as you type, unknown
#                            commands turn red
#
# Both are cloned into $ZSH_CUSTOM/plugins by install.sh.
# zsh-syntax-highlighting must stay last: it wraps the line editor's widgets
# and anything loaded after it ends up unhighlighted.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# Skip oh-my-zsh's "insecure completion directories" check.
ZSH_DISABLE_COMPFIX="true"

source "$ZSH/oh-my-zsh.sh"

# User configuration

# Shared aliases, linked from conf/aliases. Sourced after oh-my-zsh so these
# win over the ones its libs and plugins define.
[ -r "${HOME}/.aliases" ] && source "${HOME}/.aliases"

# Anything you don't want to commit (machine-local paths, tokens, ...).
[ -r "${HOME}/.extra" ] && source "${HOME}/.extra"

# User-local binaries, e.g. things installed by pipx.
[ -d "${HOME}/.local/bin" ] && export PATH="${PATH}:${HOME}/.local/bin"
